# Neon Postgres (Vercel подставляет автоматически после подключения Storage → Neon)
DATABASE_URL=            # строка подключения (pooled)
DATABASE_URL_UNPOOLED=   # прямое подключение для миграций (локально — то же, что DATABASE_URL)
APP_PASSWORD_HASH=       # bcrypt-хеш пароля входа (npm run hash-password)
SESSION_SECRET=          # случайная строка ≥ 32 символов
CRON_SECRET=             # секрет для /api/cron/*
TELEGRAM_BOT_TOKEN=      # токен бота от @BotFather (напоминания в Telegram)
APP_URL=                 # https://<имя-проекта>.vercel.app — для ссылок в сообщениях бота
