generator client {
  provider        = "prisma-client-js"
  // Связанные данные (роли, ответственные, этап…) загружаются одним запросом, а не пятью
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ---------- Пользователи (задел на персональные логины) ----------

enum UserRole {
  ADMIN
  EDITOR
  VIEWER
}

model User {
  id           Int      @id @default(autoincrement())
  login        String   @unique
  name         String
  passwordHash String?
  role         UserRole @default(EDITOR)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
}

model LoginAttempt {
  id        Int      @id @default(autoincrement())
  ip        String
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
}

// ---------- Справочники ----------

model Stage {
  id        Int            @id @default(autoincrement())
  name      String         @unique
  order     Int            @default(0)
  color     String         @default("#1F4E9E")
  archived  Boolean        @default(false)
  tasks     Task[]
  templates TemplateTask[]
}

model Block {
  id        Int            @id @default(autoincrement())
  name      String         @unique
  order     Int            @default(0)
  archived  Boolean        @default(false)
  tasks     Task[]
  templates TemplateTask[]
}

model Role {
  id        Int            @id @default(autoincrement())
  name      String         @unique
  order     Int            @default(0)
  archived  Boolean        @default(false)
  employees Employee[]
  tasks     Task[]
  templates TemplateTask[]
}

model Employee {
  id             Int      @id @default(autoincrement())
  fullName       String
  position       String?
  telegram       String?
  /// Чат с ботом Telegram (появляется после /start у бота)
  telegramChatId String?
  active         Boolean  @default(true)
  roles          Role[]
  tasks          Task[]
  createdAt      DateTime @default(now())
}

/// Справочник формулировок срока («за 2 недели до форума», «до старта продаж»…)
model TermPhrase {
  id        Int      @id @default(autoincrement())
  text      String   @unique
  order     Int      @default(0)
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model TemplateTask {
  id          Int     @id @default(autoincrement())
  number      Int
  stageId     Int?
  stage       Stage?  @relation(fields: [stageId], references: [id])
  blockId     Int?
  block       Block?  @relation(fields: [blockId], references: [id])
  description String
  termText    String  @default("")
  comment     String?
  order       Int     @default(0)
  roles       Role[]
  /// Стоимость выполнения задачи, руб.
  cost        Int     @default(0)
}

// ---------- Форумы и задачи ----------

model Forum {
  id                Int           @id @default(autoincrement())
  name              String
  startDate         DateTime      @db.Date
  endDate           DateTime?     @db.Date
  salesStartDate    DateTime      @db.Date
  location          String?
  /// Сайт форума
  website           String?
  /// Цвет карточки (ключ из src/lib/forum-colors.ts)
  color             String        @default("blue")
  /// Предельно допустимые расходы, руб. (null — лимит не задан)
  expenseLimit      Int?
  /// Доходы: с какой даты действуют цены «Середины» и «Финальной стадии»; null — период делится поровну
  priceMidDate      DateTime?     @db.Date
  priceFinalDate    DateTime?     @db.Date
  /// Доходы: цель = расходы + incomeMargin %
  incomeMargin      Int           @default(30)
  /// Доходы: вариант автоподбора плана (0 — типовой; «Другой вариант» — следующий)
  incomeVariant     Int           @default(0)
  /// Доходы: снимки плана для кнопки «Вернуть» (PlanSnapshot[], последний — текущий)
  incomePlanHistory Json          @default("[]")
  /// Курс доллара, руб. за 1 $ (null — не задан): столбцы «$» и диаграммы в $
  usdRate           Float?
  archived          Boolean       @default(false)
  /// Возвращён из архива вручную — автоархив прошедших форумов его не трогает
  keepActive        Boolean       @default(false)
  reportDate        DateTime?     @db.Date
  /// Устарело: сортировка «Отчёта для АЭ» теперь у каждой его диаграммы (ReportChart.sort)
  aeReportSort      String        @default("desc")
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  tasks             Task[]
  charts            ReportChart[]
  incomeItems       IncomeItem[]
  deals             Deal[]
}

/// Линия доходов: позиция (партнёрство или билет) — цена за единицу, план и факт продаж
model IncomeItem {
  id         Int     @id @default(autoincrement())
  forumId    Int
  forum      Forum   @relation(fields: [forumId], references: [id], onDelete: Cascade)
  /// Ключ позиции из src/lib/income.ts
  key        String
  /// Цена одной единицы, руб.
  price      Int
  /// Индивидуальная скидка, %
  discount   Float   @default(0)
  /// План, шт.
  planQty    Int     @default(0)
  /// Продано фактически, шт.
  factQty    Int     @default(0)
  /// Стадия продаж билета: 0 — старт, 1 — середина, 2 — финал (у партнёрств 0)
  stage      Int     @default(0)
  /// План задан вручную; иначе количество подбирается под цель автоматически
  planManual Boolean @default(false)
  /// Название позиции (своё или переименованная позиция по умолчанию)
  label      String?
  /// Группа своей позиции: partners | tickets
  group      String?
  /// Позиция по умолчанию убрана из списка
  removed    Boolean @default(false)
  /// Статья только для факта: в плане её нет
  factOnly   Boolean @default(false)

  @@unique([forumId, key])
}

/// Сделка воронки продаж
model Deal {
  id             Int       @id @default(autoincrement())
  forumId        Int
  forum          Forum     @relation(fields: [forumId], references: [id], onDelete: Cascade)
  company        String
  /// Откуда пришёл (кто привёл): источник лида
  source         String?
  /// Кто ведёт сделку
  manager        String?
  enteredAt      DateTime? @db.Date
  /// Направление дохода: ключ позиции доходов (src/lib/income.ts)
  incomeKey      String?
  qty            Int       @default(0)
  /// Сумма сделки, руб.
  amount         Int       @default(0)
  /// Этап из src/lib/funnel.ts: qualification … paid или refused
  status         String    @default("qualification")
  /// На каком этапе отказ
  lostStage      String?
  /// Когда сделка перешла на текущий этап
  stageChangedAt DateTime? @db.Date
  decisionDate   DateTime? @db.Date
  paidDate       DateTime? @db.Date
  comment        String?
  /// Оплаченная сделка в факте доходов: null — ждёт решения, added | rejected
  incomeStatus   String?
  /// Куда добавлена: позиция доходов и этап продаж
  incomeItemKey  String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([forumId])
}

enum TaskStatus {
  NOT_STARTED
  IN_PROGRESS
  DONE
}

model Task {
  id                 Int           @id @default(autoincrement())
  forumId            Int
  forum              Forum         @relation(fields: [forumId], references: [id], onDelete: Cascade)
  number             Int
  stageId            Int?
  stage              Stage?        @relation(fields: [stageId], references: [id])
  blockId            Int?
  block              Block?        @relation(fields: [blockId], references: [id])
  description        String
  termText           String        @default("")
  startDate          DateTime?     @db.Date
  endDate            DateTime?     @db.Date
  needsClarification Boolean       @default(false)
  datesManual        Boolean       @default(false)
  /// Ответственные изменены вручную — автоназначение по ролям их не трогает
  employeesManual    Boolean       @default(false)
  status             TaskStatus    @default(NOT_STARTED)
  completedAt        DateTime?     @db.Date
  comment            String?
  order              Int           @default(0)
  roles              Role[]
  employees          Employee[]
  history            TaskHistory[]
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  /// Стоимость выполнения задачи, руб.
  cost               Int           @default(0)
  /// Фактические расходы по задаче на сегодня, руб.
  costFact           Int           @default(0)
  /// Направление расходов (ключ из src/lib/expenses.ts); null — определяется автоматически
  expenseCategory    String?

  @@index([forumId, order])
}

model TaskHistory {
  id        Int      @id @default(autoincrement())
  taskId    Int
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  field     String
  oldValue  String?
  newValue  String?
  changedBy String
  changedAt DateTime @default(now())

  @@index([taskId, changedAt])
}

// ---------- Отчёт ----------

enum ChartPalette {
  RED
  GREEN
  BLUE
  PURPLE
  CYAN
  ORANGE
}

model ReportChart {
  id          Int          @id @default(autoincrement())
  forumId     Int
  forum       Forum        @relation(fields: [forumId], references: [id], onDelete: Cascade)
  title       String
  palette     ChartPalette @default(BLUE)
  unit        String       @default("млн руб.")
  order       Int          @default(0)
  /// Порядок статей в диаграмме: desc — по убыванию, asc — по возрастанию
  sort        String       @default("desc")
  /// Вкладка: main — «Отчёт», ae — «Отчёт для АЭ»
  report      String       @default("main")
  /// Автоматическая диаграмма: ключ из src/lib/report/auto-charts.ts, строки берутся
  /// из «Расходов» и «Доходов» кнопкой «Автообновление»; null — строки вносятся вручную
  source      String?
  /// Когда строки автоматической диаграммы последний раз взяты из «Расходов» и «Доходов»
  /// (суммы её строк хранятся в рублях); null — ещё ни разу
  refreshedAt DateTime?
  /// Строки автоматической диаграммы поправлены вручную; «Автообновление» возвращает исходные
  edited      Boolean      @default(false)
  /// В подразделе «Архив»
  archived    Boolean      @default(false)
  items       ReportItem[]

  @@index([forumId, report])
}

model ReportItem {
  id      Int         @id @default(autoincrement())
  chartId Int
  chart   ReportChart @relation(fields: [chartId], references: [id], onDelete: Cascade)
  name    String
  amount  Decimal     @default(0) @db.Decimal(14, 2)
  /// Дополнительная единица, выводится в скобках: «6 шт.»
  note    String?
  order   Int         @default(0)
}

// ---------- Напоминания ----------

model ReminderSettings {
  id                  Int     @id @default(1)
  daysBefore          Int     @default(3)
  weeklySummary       Boolean @default(true)
  /// Личные сообщения ответственным в Telegram
  telegramPersonal    Boolean @default(true)
  /// Сводка в общий чат команды
  telegramGroup       Boolean @default(true)
  telegramGroupChatId String?
  telegramGroupTitle  String?
}

model ReminderLog {
  id         Int      @id @default(autoincrement())
  dayKey     String
  kind       String
  /// канал отправки (telegram)
  channel    String   @default("telegram")
  taskId     Int?
  employeeId Int?
  recipient  String
  subject    String
  status     String
  error      String?
  createdAt  DateTime @default(now())

  @@index([dayKey])
  @@index([dayKey, taskId, employeeId])
}

/// Производственный календарь: исключения из обычной недели (сб, вс — выходные).
/// holiday — праздничный / нерабочий день; workday — рабочий день (перенос на выходной);
/// short — сокращённый рабочий день.
model CalendarDay {
  date DateTime @id @db.Date
  kind String
  note String?
}
